# Copy to .env for local testing (do not commit the real .env file)

SHIPHERO_REFRESH_TOKEN=
# Leave blank if Universal Parks' ShipHero token is already scoped to a
# single customer account (i.e. it's not a 3PL parent account acting on
# behalf of others). Check with the `is_3pl` query in the README before
# assuming either way.
SHIPHERO_CUSTOMER_ACCOUNT_ID=
# Leave blank to include orders from every warehouse on the account
SHIPHERO_WAREHOUSE_ID=

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

REPORT_RECIPIENTS=you@verticalpassage.com,someoneelse@verticalpassage.com

# Optional tuning
# If Universal Parks' account has no warehouse filter, a large lookback
# window scans every order across every warehouse and can hit ShipHero's
# credit limits. Start small (7 days) and raise it later if needed once
# you've confirmed the daily run comfortably fits within the account's
# credit quota.
LOOKBACK_DAYS=7
PREORDER_TAG=preorder
# SKUs affecting this many distinct orders (or more) are excluded from the
# report — treated as an already-known, larger-scale stockout rather than
# something that needs surfacing. Snow Commerce used 5; Universal Parks'
# order volume may call for a different number.
MAX_ORDERS_PER_SKU=5
